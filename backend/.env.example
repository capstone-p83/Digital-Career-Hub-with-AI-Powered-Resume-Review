# Copy this file to `.env` in this folder and fill in values (see README.md).

PORT=5001

# PostgreSQL connection string (used by config/db.js). Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require&channel_binding=require
DATABASE_URL=

JWT_SECRET=replace-with-a-long-random-string

GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Google Gemini — required for POST /api/resume/review analysis
GEMINI_API_KEY=

# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=digital_career_hub
