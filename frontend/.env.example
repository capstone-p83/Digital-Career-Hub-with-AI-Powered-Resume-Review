# Frontend env templates:
# - Copy `.env.local.example` to `.env.local` for Next.js local dev (recommended).
# - Values prefixed with NEXT_PUBLIC_ are exposed to the browser.

NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_TENANT_ID=

# Gemini API (optional; used by resume AI features)
GEMINI_API_KEY=
